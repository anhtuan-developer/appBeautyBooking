# Browser on development computer:
# EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
# Physical Android/iPhone: use the current computer LAN IPv4 address.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api
# Production: use the HTTPS API URL, for example https://api.example.com/api
